upstream chatwoot_app {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    server_name chat.barboo.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name chat.barboo.com.br;

    # Ajuste os caminhos dos certificados conforme seu ambiente.
    ssl_certificate     /etc/letsencrypt/live/chat.barboo.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.barboo.com.br/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 20m;

    location / {
        proxy_pass http://chatwoot_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
    }
}
